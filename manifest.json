{
  "manifest_version": 3,
  "name": "Quick Screenshot",
  "version": "2.0.0",
  "description": "Quick Screenshot is a Chrome extension that allows you to take screenshots of the current tab and download them.",
  "permissions": ["contextMenus", "activeTab", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Take Screenshot (Alt+Shift+S)"
  },
  "commands": {
    "take-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Take Screenshot"
    }
  }
}
